    "/api/books": {
      "get": {
        "operationId": "listBooks",
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "books": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "title": {
                            "type": "string"
                          },
                          "authors": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "seriesName": {
                            "nullable": true,
                            "type": "string"
                          },
                          "seriesIndex": {
                            "nullable": true,
                            "type": "number"
                          },
                          "coverUrl": {
                            "nullable": true,
                            "type": "string"
                          },
                          "formats": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "enum": ["epub", "mobi", "azw3", "pdf", "cbz", "other"]
                            }
                          },
                          "owned": {
                            "type": "boolean"
                          },
                          "addedAt": {
